# ---- 运行时 ----
# 服务端口：pnpm dev / pnpm start 默认 5000，可用 DEPLOY_RUN_PORT 覆盖
DEPLOY_RUN_PORT=5000
# 监听地址（容器内部署时可设为 0.0.0.0）
DEPLOY_HOST=127.0.0.1

# ---- 数据层 ----
# JSON 数据目录，默认是项目根目录下的 data/
# SNACKOPS_DATA_DIR=./data

# ---- LLM Provider ----
# 可选值：coze / openai-compatible / classroom-fixture
# 不设置时会按密钥推断；如果都没有，Agent 会返回结构化错误（不会静默降级成演示模式）
#
# 课堂演示模式（无外部密钥，确定性输出，会明确标注）：
# LLM_PROVIDER=classroom-fixture
#
# OpenAI 兼容服务：
# LLM_PROVIDER=openai-compatible
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Coze（需要先 pnpm add coze-coding-dev-sdk）：
# LLM_PROVIDER=coze
# COZE_API_KEY=your-key
# COZE_MODEL=doubao-1-5-pro-32k-250115
# COZE_BASE_URL=https://api.coze.cn

# 单次模型调用超时（毫秒）
# LLM_TIMEOUT_MS=30000

# ---- Agent 主链路 ----
# Skill / Tool 的单步超时
# AGENT_SKILL_TIMEOUT_MS=20000
# AGENT_TOOL_TIMEOUT_MS=10000
# AGENT_RISK_TIMEOUT_MS=15000

# 故障注入开关：只有设为 1 时，请求体里的 faults 才会生效（用于验收「Tool 报错」「Skill 超时」）
# SNACKOPS_ALLOW_FAULTS=1
